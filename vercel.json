{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx pnpm@11.17.0 build",
  "installCommand": "npx pnpm@11.17.0 install --frozen-lockfile",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lab",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/labo",
      "destination": "/",
      "permanent": true
    }
  ]
}

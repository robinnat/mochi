{
  "name": "mochiz-world",
  "version": "0.2.1",
  "description": "Mochiz: animated avatars for the web. A <mochi-bot> Web Component that draws a Mochi in real 3D (Soft, Flat, Pixel), with 12 shapes, 7 moods, reactions to touch and 22 accessories. No framework needed.",
  "license": "MIT",
  "author": "SYGEN SAS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinnat/mochiz.git"
  },
  "homepage": "https://mochiz.vercel.app",
  "bugs": {
    "url": "https://github.com/robinnat/mochiz/issues"
  },
  "keywords": [
    "3d",
    "threejs",
    "animation",
    "avatar",
    "mascot",
    "web-components",
    "custom-element",
    "mochi",
    "avatars",
    "webgl",
    "web-component",
    "three"
  ],
  "type": "module",
  "main": "./dist-lib/mochiz.js",
  "module": "./dist-lib/mochiz.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/mochiz.js",
      "default": "./dist-lib/mochiz.js"
    },
    "./catalog": {
      "types": "./dist-lib/types/catalog.d.ts",
      "import": "./dist-lib/catalog.js",
      "default": "./dist-lib/catalog.js"
    },
    "./standalone": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/standalone/mochiz.js",
      "default": "./dist-lib/standalone/mochiz.js"
    },
    "./standalone/catalog": {
      "types": "./dist-lib/types/catalog.d.ts",
      "import": "./dist-lib/standalone/catalog.js",
      "default": "./dist-lib/standalone/catalog.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist-lib/mochiz.js",
    "./dist-lib/standalone/mochiz.js",
    "./src/**",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.lib.config.ts --mode standalone && node tools/lib-types.mjs",
    "prepublishOnly": "npm run test && npm run build:lib"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "happy-dom": "^21.0.4",
    "mediabunny": "^1.65.2",
    "three": "0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}

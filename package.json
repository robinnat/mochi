{
  "name": "mochis",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Mochis: animated avatar engine for the web. Mochi characters in real 3D (Soft, Flat, Pixel), with 12 shapes, 7 moods, reactions to touch, 22 accessories and exports (PNG, SVG, GIF, MP4), all from the 3D.",
  "license": "MIT",
  "author": "SYGEN SAS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinnat/mochi.git"
  },
  "homepage": "https://mochi-red-phi.vercel.app",
  "bugs": {
    "url": "https://github.com/robinnat/mochi/issues"
  },
  "keywords": [
    "3d",
    "threejs",
    "animation",
    "avatar",
    "morphing",
    "web-components",
    "custom-element"
  ],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build --config vite.lib.config.ts"
  },
  "dependencies": {
    "mediabunny": "^1.65.2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
